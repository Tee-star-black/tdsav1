{
  "name": "teledoctorsa-blog-cms",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "start": "node server/server.mjs",
    "dev": "node server/server.mjs",
    "studio": "node server/server.mjs",
    "content:export": "node scripts/export-content.mjs",
    "content:validate": "node scripts/validate-content.mjs content/articles.json",
    "build:blog": "npm run content:export && npm run build:blog:from-file",
    "check": "node scripts/smoke-vertical.mjs",
    "check:workflow": "node --test tests/workflow.test.mjs tests/server.test.mjs tests/text-only-render.test.mjs",
    "check:editor": "node --test tests/editor.test.mjs tests/staff-ui.test.mjs",
    "user:create": "node scripts/create-user.mjs",
    "check:auth": "node --test tests/auth.test.mjs tests/google-auth.test.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "check:postgres": "node --test tests/postgres.test.mjs",
    "build:blog:from-file": "node scripts/build-blog.mjs",
    "build:blog:local": "npm run content:export && npm run build:blog:from-file",
    "publish:job": "node scripts/publish-cloud-run-job.mjs",
    "check:publisher": "node --test tests/publish-dispatch.test.mjs tests/publish-job.test.mjs"
  },
  "dependencies": {
    "nunjucks": "^3.2.4",
    "pg": "^8.16.3",
    "google-auth-library": "^11.3.1",
    "@google-cloud/storage": "^7.17.2"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "jsdom": "30.1.1",
    "pg-mem": "^3.0.5"
  },
  "overrides": {
    "mux-embed": "5.18.2"
  }
}
