{
  "name": "teledoctorsa-blog-cms",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "studio:preview": "npx serve prototype",
    "blog:preview": "npx serve public-preview",
    "sanity:dev": "sanity dev --config sanity/sanity.config.ts",
    "sanity:deploy": "sanity deploy --config sanity/sanity.config.ts",
    "content:fetch": "node scripts/fetch-sanity.mjs",
    "content:validate": "node scripts/validate-content.mjs content/articles.json",
    "build:blog": "node scripts/build-blog.mjs",
    "build:sample": "npm run content:validate && npm run build:blog"
  },
  "dependencies": {
    "@sanity/client": "^7.11.2",
    "@sanity/vision": "^4.10.0",
    "nunjucks": "^3.2.4",
    "sanity": "^4.10.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "serve": "^14.2.4",
    "typescript": "^5.9.2"
  }
}