{
  "name": "teledoctorsa-blog-cms",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "start": "node server/server.mjs",
    "dev": "node server/server.mjs",
    "studio": "node server/server.mjs",
    "sanity:dev": "sanity dev --config sanity/sanity.config.ts",
    "sanity:deploy": "sanity deploy --config sanity/sanity.config.ts",
    "content:fetch": "node scripts/fetch-sanity.mjs",
    "content:export": "node scripts/export-content.mjs",
    "content:validate": "node scripts/validate-content.mjs content/articles.json",
    "build:blog": "npm run content:export && node scripts/build-blog.mjs",
    "check": "node scripts/smoke-vertical.mjs",
    "check:sanity": "node scripts/sanity-contract.mjs",
    "check:workflow": "node --test tests/workflow.test.mjs tests/server.test.mjs",
    "check:editor": "node --test tests/editor.test.mjs",
    "user:create": "node scripts/create-user.mjs",
    "check:auth": "node --test tests/auth.test.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "content:fetch-public": "node scripts/fetch-public-content.mjs",
    "migrate:sanity-to-postgres": "node scripts/migrate-sanity-to-postgres.mjs",
    "check:postgres": "node --test tests/postgres.test.mjs",
    "build:blog:from-file": "node scripts/build-blog.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@sanity/client": "^7.11.2",
    "nunjucks": "^3.2.4",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@sanity/vision": "^4.10.0",
    "jsdom": "30.1.1",
    "pg-mem": "^3.0.5",
    "sanity": "^4.10.0",
    "typescript": "^5.9.2"
  }
}
