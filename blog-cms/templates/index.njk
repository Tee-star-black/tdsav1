<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Blog & Insights | {{ site.name }}</title>
  <meta name="description" content="Health education, company news and digital care insights from TeleDoctorSA.">
  <link rel="canonical" href="{{ site.baseUrl }}/blog/">
  <link rel="stylesheet" href="/styles/blog.css">
</head>
<body class="tdsa-blog">
  <main>
    <header class="blog-hero"><p>TELEDOCTORSA EDITORIAL</p><h1>Blog & Insights</h1><span>Useful health information, product updates and stories from connected care.</span></header>
    <section class="blog-grid" aria-label="Latest articles">
      {% for article in articles %}
      <article class="blog-card">
        <a href="/blog/{{ article.slug }}/" class="blog-card-image"><img src="{{ article.coverImage.url }}" alt="{{ article.coverImage.alt }}" loading="lazy"></a>
        <div class="blog-card-copy"><span>{{ article.category.title }}</span><h2><a href="/blog/{{ article.slug }}/">{{ article.title }}</a></h2><p>{{ article.excerpt }}</p><small>{{ article.author.name }} · {{ article.publishedAt | truncate(10, true, '') }}</small></div>
      </article>
      {% endfor %}
    </section>
  </main>
</body>
</html>
