# local = JSON-backed development repository
# sanity = Sanity Content Lake repository
CMS_BACKEND=local
PORT=8790
CMS_HOST=127.0.0.1

# Required when the production Sanity dataset may be mutated.
# Local development can leave this false when CMS_BACKEND=local.
CMS_ALLOW_PRODUCTION_WRITES=false

# Production API security.
# Leave CMS_ACCESS_TOKEN empty only for local development.
CMS_ACCESS_TOKEN=
CMS_ALLOWED_ORIGINS=https://cms.teledoctorsa.co.za,https://teledoctorsa.co.za,https://www.teledoctorsa.co.za

# Optional deploy hook called when published content changes.
# For GitHub repository_dispatch, use:
# CMS_DEPLOY_WEBHOOK_URL=https://api.github.com/repos/Tee-star-black/tdsav1/dispatches
# CMS_DEPLOY_WEBHOOK_TOKEN=<fine-grained GitHub token with Actions/Contents access>
CMS_DEPLOY_WEBHOOK_URL=
CMS_DEPLOY_WEBHOOK_TOKEN=

# TeleDoctorSA Sanity project
SANITY_PROJECT_ID=glz6ptd8
SANITY_STUDIO_PROJECT_ID=glz6ptd8
SANITY_DATASET=production
SANITY_STUDIO_DATASET=production
SANITY_API_VERSION=2026-09-01

# Public datasets can be read without SANITY_READ_TOKEN.
# Writes require SANITY_WRITE_TOKEN and must remain server-side.
SANITY_READ_TOKEN=
SANITY_WRITE_TOKEN=
