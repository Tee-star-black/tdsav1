# local = JSON-backed development repository
# sanity = Sanity Content Lake repository
CMS_BACKEND=local
PORT=8787
CMS_HOST=127.0.0.1

# Production API security.
# Leave CMS_ACCESS_TOKEN empty only for local development.
CMS_ACCESS_TOKEN=
CMS_ALLOWED_ORIGINS=https://teledoctorsa.co.za,https://www.teledoctorsa.co.za

# Optional deploy hook called when published content changes.
CMS_DEPLOY_WEBHOOK_URL=
CMS_DEPLOY_WEBHOOK_TOKEN=

# TeleDoctorSA Sanity project
SANITY_PROJECT_ID=glz6ptd8
SANITY_STUDIO_PROJECT_ID=glz6ptd8

# Local prototype + CI use staging so test content never touches production.
SANITY_DATASET=staging
SANITY_STUDIO_DATASET=staging

# Production hosting must explicitly override SANITY_DATASET=production.
SANITY_PRODUCTION_DATASET=production
SANITY_API_VERSION=2026-09-01

# Public datasets can be read without SANITY_READ_TOKEN.
# Writes require SANITY_WRITE_TOKEN and must remain server-side.
SANITY_READ_TOKEN=
SANITY_WRITE_TOKEN=
