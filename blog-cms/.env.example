# TeleDoctorSA Publishing Studio environment
# Local development defaults to the JSON/file backends.
PORT=8790
CMS_HOST=127.0.0.1

# Content backend: local (development) | postgres (production). Production uses PostgreSQL only.
CMS_BACKEND=local

# Authentication backend: file | postgres
# When CMS_BACKEND=postgres, auth defaults to postgres if this is omitted.
CMS_AUTH_BACKEND=file
CMS_AUTH_FILE=./data/auth.local.json
CMS_SESSION_HOURS=12
CMS_COOKIE_SECURE=false

# PostgreSQL / Cloud SQL
# Use DATABASE_URL OR standard PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD values.
DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSL=
PGPOOL_MAX=10

# Media backend: local | gcs
# Media uploads stay disabled in production until GCS and image delivery pass acceptance.
CMS_MEDIA_UPLOADS_ENABLED=
CMS_MEDIA_BACKEND=local
GCS_BUCKET=
GCS_PUBLIC_BASE_URL=
GCS_PREFIX=blog

# Production request/security settings.
CMS_ACCESS_TOKEN=
CMS_ALLOWED_ORIGINS=https://cms.teledoctorsa.co.za,https://teledoctorsa.co.za,https://www.teledoctorsa.co.za
CMS_INTERNAL_TOKEN=
CMS_SCHEDULE_WORKER_ENABLED=true

# Deploy hook called whenever published content changes.
CMS_DEPLOY_WEBHOOK_URL=
CMS_DEPLOY_WEBHOOK_TOKEN=
