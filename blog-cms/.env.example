# TeleDoctorSA Publishing Studio environment
# Local development defaults to the JSON/file backends.
PORT=8790
CMS_HOST=127.0.0.1

# Content backend: local (development) | postgres (production). Production uses PostgreSQL only.
CMS_BACKEND=local

# Authentication backend: file | postgres
# When CMS_BACKEND=postgres, auth defaults to postgres if this is omitted.
CMS_AUTH_BACKEND=file
CMS_AUTH_FILE=./data/auth.local.json
CMS_SESSION_HOURS=12
CMS_COOKIE_SECURE=false

# Optional Google Workspace login. Keep both blank until OAuth client and
# migration 002 have been configured and an exact HTTPS origin is authorised.
# The Google client ID is public; no client secret is used.
CMS_GOOGLE_CLIENT_ID=
CMS_GOOGLE_WORKSPACE_DOMAIN=

# PostgreSQL / Cloud SQL
# Use DATABASE_URL OR standard PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD values.
DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSL=
PGPOOL_MAX=10

# Media backend: local | gcs
# Media uploads stay disabled in production until GCS and image delivery pass acceptance.
CMS_MEDIA_UPLOADS_ENABLED=
CMS_MEDIA_BACKEND=local
GCS_BUCKET=
GCS_PUBLIC_BASE_URL=
GCS_PREFIX=blog

# Production request/security settings.
CMS_ACCESS_TOKEN=
CMS_ALLOWED_ORIGINS=https://cms.teledoctorsa.co.za,https://teledoctorsa.co.za,https://www.teledoctorsa.co.za
CMS_INTERNAL_TOKEN=
CMS_SCHEDULE_WORKER_ENABLED=true

# Cloud Run publishing job (the CMS service identity needs run.jobs.run on this job).
# Leave CMS_PUBLISH_JOB blank until the job and its permissions are verified.
CMS_PUBLISH_PROJECT=teledoctor-it
CMS_PUBLISH_REGION=africa-south1
CMS_PUBLISH_JOB=

# Cloud Run Job only: dry run by default, never touches the live website.
CMS_PUBLISH_DRY_RUN=true
CMS_PUBLISH_VERIFY_BASE_URL=https://teledoctorsa.co.za
# Provide FTP settings as Secret Manager environment secrets on the JOB, never in this file.
CMS_FTP_HOST=
CMS_FTP_USERNAME=
CMS_FTP_PASSWORD=
CMS_FTP_REMOTE_ROOT=
